  "_meta": {
    "models": {
      "userProfile": "O paciente dono da conta — identidade mascarada (ex: DC.945), idade biológica, altura e peso. Alimenta o painel HUD 'PROFILE' com silhueta corporal e dados básicos.",
      "vitalsSnapshot": "Foto dos sinais vitais mais recentes do User (frequência cardíaca, temperatura, oxigenação, último sono). Renderizados nos painéis HUD ao redor do avatar.",
      "hudPanels": "Painéis angulares ao redor do avatar central, cada um focado num grupo de dados de saúde. Têm 3 estados visuais (idle escurecido, active com glow ciano, alert com borda âmbar) e acendem conforme o tópico atual da conversa.",
      "currentSession": "Sessão de voz ativa no momento — invocada pelo User há poucos segundos. Mostra o estado atual do avatar (idle/listening/thinking/speaking), estado do microfone e os últimos 3-4 turnos visíveis na transcrição HUD.",
      "utterances": "Cada turno da conversa entre User e Nymos. Tem autor, texto, timestamp, intent detectado (registro/consulta/conversa/comando) e — quando aplicável — referência à entity criada/consultada e link de drill-down pra section correspondente.",
      "recentSessions": "Histórico das últimas sessões do User para a sub-rota /assistente-nymos/historico. Cada item mostra data, duração, n° de turnos, prévia do primeiro turno do User e tags do que foi feito (registro, consulta, drill-down).",
      "memories": "Fatos e preferências que o Nymos aprendeu sobre o User ao longo das sessões. Cada memory tem categoria, conteúdo, origem (utterance que gerou) e flag de esquecimento. User pode pedir 'Nymos, esquece X' a qualquer momento.",
      "proactiveSuggestion": "Sugestão proativa pendente (modo opt-in). Quando existe, o ícone flutuante do shell muda scanner pra âmbar e ganha badge. Ao abrir, o Nymos entra direto em 'speaking' com a sugestão."
    },
    "relationships": [
      "Cada VoiceSession pertence a um User e contém múltiplas Utterances ordenadas cronologicamente",
      "Cada Utterance opcionalmente referencia uma entity criada (Meal, Metric, MoodCheckIn, Activity, BodyComposition, JournalEntry) ou consultada — útil pra renderizar chips de drill-down",
      "Cada AssistantMemory pertence a um User e opcionalmente aponta pra Utterance que originou ela",
      "Os hudPanels são derivados do userProfile + vitalsSnapshot + últimos dados de saúde do User, não são entities persistidas — são visualizações que acendem conforme contexto da conversa",
      "ProactiveSuggestion é gerada pelo backend quando detecta gap nos dados (ex: 3 dias sem registrar peso) e some quando o User aceita ou recusa"
    ]
  },

